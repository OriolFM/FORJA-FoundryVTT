# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude Code
.claude/

# Build artifacts
dist/

# Compendis compilats (LevelDB): NO van a git. Foundry els reescriu cada cop que
# s'obre el món. Es generen a partir de les fonts (packs/_source) amb `npm run compila`.
packs/*/
!packs/_source/
moduls/*/packs/*/
!moduls/*/packs/_source/
mon-proves/**/LOCK
mon-proves/**/LOG
mon-proves/**/LOG.old
# Configuració del món: hi ha claus privades (p. ex. la de FORJAPP). Mai a git.
mon-proves/*/data/settings/

# graphify (graf de coneixement del codi, es genera localment)
graphify-out/
captures/

# SECRETS: claus, contrasenyes, tokens i credencials MAI van a git (el repositori és públic).
# Si cal, es puja un fitxer d'exemple sense valors reals (p. ex. .env.example).
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets.json
secrets.env
secrets.yml
secrets.yaml
secrets.txt
credencials*
CREDENCIALS*
credentials*
**/settings/*.ldb
**/data/settings/
.cache/
