<div class="forja-missatge-tirada {{#if pifia}}missatge-pifia{{else}}{{#if exit}}missatge-exit{{else}}missatge-fallada{{/if}}{{/if}}">

  <!-- Capçalera -->
  <div class="mt-cap">
    <span class="mt-label">{{label}}</span>
    <span class="mt-dif">{{localize "FORJA.Display.Dificultats"}} {{dificultat}}</span>
  </div>

  <!-- Daus -->
  <div class="mt-daus">
    {{#each dice as |d|}}
    <span class="mt-dau {{dieClass d}}">{{d}}</span>
    {{/each}}
  </div>

  <!-- Resultat -->
  <div class="mt-resultat">
    {{#if pifia}}
      <span class="mt-badge badge-pifia"><i class="fas fa-skull"></i> {{localize "FORJA.Display.Pifia"}}</span>
    {{else if exit}}
      <span class="mt-badge badge-exit">
        <i class="fas fa-check"></i>
        {{fites}} {{#if (eq fites 1)}}{{localize "FORJA.Dice.Fita"}}{{else}}{{localize "FORJA.Dice.Fites"}}{{/if}}
        {{#if excedent}}<span class="mt-excedent">+{{excedent}} {{localize "FORJA.Display.Excedent"}}</span>{{/if}}
      </span>
    {{else}}
      <span class="mt-badge badge-fallada">
        <i class="fas fa-xmark"></i>
        {{fites}} {{#if (eq fites 1)}}{{localize "FORJA.Dice.Fita"}}{{else}}{{localize "FORJA.Dice.Fites"}}{{/if}}
      </span>
    {{/if}}
  </div>

  {{#if aptitud}}
  <div class="mt-mods">
    <span class="mt-mod">{{aptitud}}{{#if unsRestats}} · {{localize "FORJA.Aptitud.UnsRestats" n=unsRestats}}{{/if}}</span>
    {{#if inepteSenseNivell}}<span class="mt-mod mt-mod-penal">{{localize "FORJA.Aptitud.AvisInepte"}}</span>{{/if}}
  </div>
  {{/if}}

  <!-- Modificadors aplicats -->
  {{#if (add modDaus modDificultat)}}
  <div class="mt-mods">
    {{#if modDaus}}<span class="mt-mod">{{localize "FORJA.Display.DausModificador"}} {{#if (lt modDaus 0)}}{{modDaus}}{{else}}+{{modDaus}}{{/if}}</span>{{/if}}
    {{#if modDificultat}}<span class="mt-mod">{{localize "FORJA.Display.Dificultats"}} {{#if (lt modDificultat 0)}}{{modDificultat}}{{else}}+{{modDificultat}}{{/if}}</span>{{/if}}
    {{#if concentrat}}<span class="mt-mod">{{localize "FORJA.Dice.ConcentratBonus"}}</span>{{/if}}
    {{#if penalSalut}}<span class="mt-mod mt-mod-penal">{{localize "FORJA.Dice.PenalSalutMod" valor=penalSalut}}</span>{{/if}}
  </div>
  {{else}}
  {{#if (or concentrat penalSalut)}}
  <div class="mt-mods">
    {{#if concentrat}}<span class="mt-mod">{{localize "FORJA.Dice.ConcentratBonus"}}</span>{{/if}}
    {{#if penalSalut}}<span class="mt-mod mt-mod-penal">{{localize "FORJA.Dice.PenalSalutMod" valor=penalSalut}}</span>{{/if}}
  </div>
  {{/if}}
  {{/if}}

</div>
