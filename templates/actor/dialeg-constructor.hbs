<div class="forja-dialeg-constructor">
  <div class="dc-cos">

  <p class="dm-desc">{{#if esArtefacte}}{{localize "FORJA.Construccio.IntroArtefacte"}}{{else}}{{localize "FORJA.Construccio.Intro"}}{{/if}}</p>

  <div class="form-group dm-camp">
    <label>{{#if esArtefacte}}{{localize "FORJA.Construccio.NomArtefacte"}}{{else}}{{localize "FORJA.Construccio.Nom"}}{{/if}}</label>
    <input type="text" name="nom" value="{{nom}}" placeholder="{{localize 'FORJA.Construccio.NomPlaceholder'}}"/>
  </div>

  <div class="form-group dm-camp">
    <label>{{localize "FORJA.Construccio.Descripcio"}}</label>
    <textarea name="descripcio" rows="3" placeholder="{{localize 'FORJA.Construccio.DescripcioPlaceholder'}}">{{descripcio}}</textarea>
  </div>

  {{#if esArtefacte}}
  <div class="dc-graella">
    <div class="form-group dm-camp">
      <label>{{localize "FORJA.Construccio.Categoria"}}</label>
      <select name="categoria">
        {{#each categories as |c|}}<option value="{{c.id}}" {{#if (eq c.id ../categoria)}}selected{{/if}}>{{c.nom}}</option>{{/each}}
      </select>
    </div>
    <label class="dm-radio dc-permanent" title="{{localize 'FORJA.Construccio.PermanentDesc'}}">
      <input type="checkbox" name="permanent" {{#if permanent}}checked{{/if}}> {{localize "FORJA.Construccio.Permanent"}}
    </label>
  </div>
  {{else}}
  <div class="form-group dm-camp">
    <label>{{localize "FORJA.Construccio.Do"}}</label>
    <select name="do">
      {{#each dons as |d|}}<option value="{{d.id}}" {{#if (eq d.id ../do)}}selected{{/if}}>{{d.nom}}</option>{{/each}}
    </select>
  </div>
  {{/if}}

  <hr>
  <div class="dc-parametres">
    {{#each files as |f|}}
    <div class="dc-parametre">
      <div class="dc-parametre-cap">
        <strong>{{f.nom}}</strong>
        <a data-action="treureParametre" data-idx="{{f.idx}}" title="{{localize 'FORJA.Construccio.Treure'}}"><i class="fas fa-xmark"></i></a>
      </div>
      {{#if f.camps.length}}
      <div class="dc-graella">
        {{#each f.camps as |c|}}
        <div class="form-group dm-camp">
          <label>{{c.etiqueta}}</label>
          {{#if (eq c.tipus "select")}}
          <select data-idx="{{f.idx}}" data-camp="{{c.camp}}">
            {{#each c.opcions as |o|}}<option value="{{o.id}}" {{#if (eq o.id c.valor)}}selected{{/if}}>{{o.nom}}</option>{{/each}}
            {{#each c.grups as |g|}}<optgroup label="{{g.nom}}">
              {{#each g.opcions as |o|}}<option value="{{o.id}}" {{#if (eq o.id c.valor)}}selected{{/if}}>{{o.nom}}</option>{{/each}}
            </optgroup>{{/each}}
          </select>
          {{else if (eq c.tipus "checkbox")}}
          <input type="checkbox" data-idx="{{f.idx}}" data-camp="{{c.camp}}" {{#if c.valor}}checked{{/if}}>
          {{else}}
          <input type="number" data-idx="{{f.idx}}" data-camp="{{c.camp}}" value="{{c.valor}}" min="{{c.min}}" step="1">
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{/if}}
    </div>
    {{else}}
    <p class="dm-desc">{{localize "FORJA.Construccio.SenseParametres"}}</p>
    {{/each}}
  </div>

  <div class="dc-afegir">
    <button type="button" data-action="mostrarParametres" class="{{#if mostrarLlista}}actiu{{/if}}">
      <i class="fas {{#if mostrarLlista}}fa-xmark{{else}}fa-plus{{/if}}"></i>
      {{#if mostrarLlista}}{{localize "FORJA.Construccio.Tancar"}}{{else}}{{localize "FORJA.Construccio.Afegir"}}{{/if}}
    </button>
    {{#if mostrarLlista}}
    <div class="dc-llista-parametres">
      {{#each grupsParametres as |g|}}
      {{#if g.nom}}<div class="dc-llista-grup">{{g.nom}}</div>{{/if}}
      <div class="dc-llista-opcions">
        {{#each g.tipus as |t|}}<button type="button" data-action="afegirParametre" data-tipus="{{t.id}}">{{t.nom}}</button>{{/each}}
      </div>
      {{/each}}
    </div>
    {{/if}}
  </div>

  <hr>
  <div class="dc-graella">
    <div class="form-group dm-camp">
      <label class="dm-radio"><input type="checkbox" name="declaraDificultat" {{#if declaraDificultat}}checked{{/if}}> {{localize "FORJA.Construccio.DeclararDificultat"}}</label>
      {{#if declaraDificultat}}<input type="number" name="dificultatDeclarada" value="{{dificultatDeclarada}}" step="1">{{/if}}
    </div>
    <div class="form-group dm-camp">
      <label class="dm-radio"><input type="checkbox" name="declaraLatencia" {{#if declaraLatencia}}checked{{/if}}> {{localize "FORJA.Construccio.DeclararLatencia"}}</label>
      {{#if declaraLatencia}}<input type="number" name="latenciaDeclarada" value="{{latenciaDeclarada}}" step="1">{{/if}}
    </div>
  </div>
  <p class="dm-desc">{{localize "FORJA.Construccio.DeclararDesc"}}</p>

  </div>

  <div class="dc-total">
    <div class="dc-total-xifra">{{localize "FORJA.Construccio.Cost"}}<strong>{{resultat.cost}}</strong></div>
    <div class="dc-total-xifra">{{localize "FORJA.Construccio.Dificultat"}}<strong>{{#if (eq resultat.dificultat null)}}—{{else}}{{resultat.dificultat}}{{/if}}</strong></div>
    <div class="dc-total-xifra">{{localize "FORJA.Construccio.Latencia"}}<strong>{{resultat.latencia}}</strong></div>
  </div>
  {{#each resultants as |r|}}<p class="dc-resultant">{{r}}</p>{{/each}}
  <ul class="dc-desglossament">
    {{#each resultat.desglossament as |l|}}<li>{{l.etiqueta}}: {{l.cost}} PC{{#if l.dificultat}}, dif. {{l.dificultat}}{{/if}}{{#if l.latencia}}, lat. {{l.latencia}}{{/if}}</li>{{/each}}
  </ul>
  {{#each resultat.avisos as |a|}}<p class="dc-avis">{{a}}</p>{{/each}}

  <button type="submit">
    <i class="fas fa-hammer"></i> {{#if esArtefacte}}{{localize "FORJA.Construccio.CrearArtefacte"}}{{else}}{{localize "FORJA.Construccio.Crear"}}{{/if}}
  </button>
</div>
