<div class="forja-body">

  <!-- ═══ IDENTITAT ═══ -->
  <div class="forja-seccio" data-seccio="identitat">
    <div class="forja-seccio-cap" data-action="toggleSection">
      <i class="fas fa-chevron-down forja-chevron"></i>
      {{localize "FORJA.Section.Identitat"}}
    </div>
    <div class="forja-seccio-cos">
      <div class="forja-identitat-grid">
        <div class="forja-camp">
          <label>{{localize "FORJA.Attr.Especie"}}</label>
          <select name="system.especie">
            {{#each campos.especie as |esp|}}
            <option value="{{esp}}" {{#if (eq esp ../sys.especie)}}selected{{/if}}>
              {{localize (concat "FORJA.Especie." esp)}}
            </option>
            {{/each}}
          </select>
        </div>
        <div class="forja-camp">
          <label>{{localize "FORJA.Attr.Constitucio"}}</label>
          <select name="system.constitucio">
            {{#each campos.constitucio as |opt|}}
            <option value="{{opt.val}}" {{#if (eq opt.val ../sys.constitucio)}}selected{{/if}}>
              {{opt.nom}} ({{opt.val}})
            </option>
            {{/each}}
          </select>
        </div>
        <div class="forja-camp">
          <label>{{localize "FORJA.Attr.Mida"}}</label>
          <select name="system.mida">
            {{#each campos.mida as |opt|}}
            <option value="{{opt.val}}" {{#if (eq opt.val ../sys.mida)}}selected{{/if}}>
              {{opt.nom}} ({{opt.val}})
            </option>
            {{/each}}
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ ATRIBUTS ═══ -->
  <div class="forja-seccio" data-seccio="atributs">
    <div class="forja-seccio-cap" data-action="toggleSection">
      <i class="fas fa-chevron-down forja-chevron"></i>
      {{localize "FORJA.Section.Atributs"}}
    </div>
    <div class="forja-seccio-cos">
      <div class="forja-atributs-grid">
        {{#each campos.atributs as |attr|}}
        {{#if ../modeEdicio}}
        <div class="forja-attr-box mode-edicio">
          <span class="attr-codi">{{attr}}</span>
          <div class="attr-stepper">
            <button type="button" class="btn-stepper" data-action="ajustarAtribut"
                    data-attr="{{attr}}" data-delta="-1">−</button>
            <span class="attr-val">{{lookup ../sys.atributs attr}}</span>
            <button type="button" class="btn-stepper" data-action="ajustarAtribut"
                    data-attr="{{attr}}" data-delta="1">+</button>
          </div>
          <span class="attr-nom">{{localize (concat "FORJA.Attr." attr)}}</span>
        </div>
        {{else}}
        <div class="forja-attr-box" data-action="selectAtribut" data-attr="{{attr}}"
             title="{{localize 'FORJA.Dice.TirarAtribut'}}">
          <span class="attr-codi">{{attr}}</span>
          <span class="attr-val">{{lookup ../sys.atributs attr}}</span>
          <span class="attr-nom">{{localize (concat "FORJA.Attr." attr)}}</span>
        </div>
        {{/if}}
        {{/each}}
      </div>
    </div>
  </div>

  <!-- ═══ DERIVATS ═══ -->
  <div class="forja-seccio" data-seccio="derivats">
    <div class="forja-seccio-cap" data-action="toggleSection">
      <i class="fas fa-chevron-down forja-chevron"></i>
      {{localize "FORJA.Section.Derivats"}}
    </div>
    <div class="forja-seccio-cos">
      <div class="forja-derivats-fila">
        <div class="forja-derivat">
          <span class="derivat-nom">{{localize "FORJA.Derivat.Latencia"}}</span>
          <span class="derivat-val">{{derivats.latenciaBase}}</span>
        </div>
        <div class="forja-derivat">
          <span class="derivat-nom">{{localize "FORJA.Derivat.Defensa"}}</span>
          <span class="derivat-val">{{derivats.defensa}}</span>
        </div>
        <div class="forja-derivat">
          <span class="derivat-nom">{{localize "FORJA.Derivat.Reduccio"}}</span>
          <span class="derivat-val">{{derivats.reduccioDany}}</span>
        </div>
        <div class="forja-derivat">
          <span class="derivat-nom">{{localize "FORJA.Derivat.Reaccions"}}</span>
          <span class="derivat-val">{{derivats.reaccionsMax}}</span>
        </div>
        <div class="forja-derivat" title="{{localize 'FORJA.Derivat.MovimentDesc'}}">
          <span class="derivat-nom">{{localize "FORJA.Derivat.Caminar"}}</span>
          <span class="derivat-val">{{derivats.moviment.caminar}} m</span>
        </div>
        <div class="forja-derivat" title="{{localize 'FORJA.Derivat.MovimentDesc'}}">
          <span class="derivat-nom">{{localize "FORJA.Derivat.Correr"}}</span>
          <span class="derivat-val">{{derivats.moviment.correr}} m</span>
        </div>
        <div class="forja-derivat" title="{{localize 'FORJA.Derivat.MovimentDesc'}}">
          <span class="derivat-nom">{{localize "FORJA.Derivat.Saltar"}}</span>
          <span class="derivat-val">{{derivats.moviment.saltar}} m</span>
        </div>
      </div>
      <div class="forja-salut-accions">
        {{#if sys.concentrat}}
        <button type="button" class="forja-btn-concentrat actiu" data-action="forjaToggleConcentracio"
                title="{{localize 'FORJA.Concentracio.HintActiu'}}">
          <i class="fas fa-brain"></i> {{localize "FORJA.Concentracio.Trencar"}}
        </button>
        {{else}}
        <button type="button" class="forja-btn-concentrat" data-action="forjaToggleConcentracio"
                title="{{localize 'FORJA.Concentracio.HintInactiu'}}">
          <i class="fas fa-brain"></i> {{localize "FORJA.Concentracio.Concentrar"}}
        </button>
        {{/if}}
      </div>
    </div>
  </div>

  <!-- ═══ SALUT ═══ -->
  <div class="forja-seccio" data-seccio="salut">
    <div class="forja-seccio-cap" data-action="toggleSection">
      <i class="fas fa-chevron-down forja-chevron"></i>
      {{localize "FORJA.Section.Salut"}}
      {{#if salut.penalitzacio}}
        <span class="forja-penal-badge">−{{salut.penalitzacio}} {{localize "FORJA.Salut.Penalitzacio"}}</span>
      {{/if}}
      {{#if (eq salut.nivellEfectiu 7)}}{{#unless salut.penalitzacio}}
        <span class="forja-penal-badge forja-penal-incap">{{localize "FORJA.Salut.Incapacitat"}}</span>
      {{/unless}}{{/if}}
    </div>
    <div class="forja-seccio-cos salut-cos">
      <table class="forja-salut-taula">
        <thead>
          <tr>
            <th class="col-estat">ESTAT<br><small>(+dif.)</small></th>
            <th>{{localize "FORJA.Salut.Fatiga"}}</th>
            <th>{{localize "FORJA.Salut.Ferides"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each salut.taula as |fila|}}
          {{#unless fila.terminal}}
          <tr class="salut-fila {{#if (eq fila.num ../salut.nivellEfectiu)}}fila-activa{{/if}}">
            <td class="col-estat">
              <span class="nivell-num">{{fila.num}}</span>
              <span class="penal-str">{{fila.penalStr}}</span>
            </td>
            <td class="col-pista">
              <span class="nivell-nom">{{fila.fatiga.nom}}</span>
              {{#each fila.fatiga.caselles as |c|}}
              <button type="button" class="casella-salut {{#if c.marcat}}marcada{{/if}}"
                      data-action="toggleSalut" data-track="fatiga" data-idx="{{c.idx}}"></button>
              {{/each}}
            </td>
            <td class="col-pista">
              <span class="nivell-nom">{{fila.ferides.nom}}</span>
              {{#each fila.ferides.caselles as |c|}}
              <button type="button" class="casella-salut {{#if c.marcat}}marcada{{/if}}"
                      data-action="toggleSalut" data-track="ferides" data-idx="{{c.idx}}"></button>
              {{/each}}
            </td>
          </tr>
          {{else}}
          <tr class="salut-fila fila-terminal {{#if (eq 7 ../salut.nivellEfectiu)}}fila-activa{{/if}}">
            <td class="col-estat"><span class="nivell-num">7</span></td>
            <td class="col-pista terminal-cell">
              <button type="button" class="casella-salut casella-terminal {{#if fila.fatiga.casella.marcat}}marcada{{/if}}"
                      data-action="toggleSalut" data-track="fatiga" data-idx="{{fila.fatiga.casella.idx}}">
                {{localize "FORJA.NivellFatiga.7"}}
              </button>
            </td>
            <td class="col-pista terminal-cell">
              <button type="button" class="casella-salut casella-terminal {{#if fila.ferides.casella.marcat}}marcada{{/if}}"
                      data-action="toggleSalut" data-track="ferides" data-idx="{{fila.ferides.casella.idx}}">
                {{localize "FORJA.NivellFerides.7"}}
              </button>
            </td>
          </tr>
          {{/unless}}
          {{/each}}
        </tbody>
      </table>
      <div class="forja-salut-accions">
        <button type="button" data-action="forjaObrirCuracio">
          <i class="fas fa-kit-medical"></i> {{localize "FORJA.Curacio.Curar"}}
        </button>
        <button type="button" data-action="forjaDescansar">
          <i class="fas fa-bed"></i> {{localize "FORJA.Curacio.Descansar"}}
        </button>
      </div>
    </div>
  </div>

  <!-- ═══ SOBRENATURAL (S-20/S-21) ═══ -->
  {{#if sobrenatural}}
  <div class="forja-seccio" data-seccio="sobrenatural">
    <div class="forja-seccio-cap" data-action="toggleSection">
      <i class="fas fa-chevron-down forja-chevron"></i>
      {{localize "FORJA.Section.Sobrenatural"}}
      <span class="forja-penal-badge">{{sobrenatural.donNom}}</span>
    </div>
    <div class="forja-seccio-cos">
      {{#if (eq sobrenatural.don "qi")}}
      {{#if modeEdicio}}
      <div class="forja-camp forja-qi-atribut">
        <label>{{localize "FORJA.Sobrenatural.QiAtribut"}}</label>
        <select name="system.qiAtribut">
          <option value="FOR" {{#if (eq sys.qiAtribut "FOR")}}selected{{/if}}>{{localize "FORJA.Attr.FOR"}}</option>
          <option value="DES" {{#if (eq sys.qiAtribut "DES")}}selected{{/if}}>{{localize "FORJA.Attr.DES"}}</option>
          <option value="AGI" {{#if (eq sys.qiAtribut "AGI")}}selected{{/if}}>{{localize "FORJA.Attr.AGI"}}</option>
        </select>
      </div>
      {{/if}}
      {{/if}}
      <div class="forja-equilibri-cap">
        <span class="eq-nom">{{localize "FORJA.Sobrenatural.Equilibri"}}</span>
        <span class="eq-valor eq-zona-{{sobrenatural.zona}}">{{sobrenatural.actual}} / {{sobrenatural.max}}</span>
      </div>
      <div class="forja-equilibri-pista">
        {{#each sobrenatural.caselles as |c|}}
        <button type="button" class="casella-equilibri zona-{{c.zona}} {{#if c.marcat}}marcada{{/if}}"
                data-action="toggleEquilibri" data-idx="{{c.idx}}" title="{{c.idx}}"></button>
        {{/each}}
      </div>
      <div class="forja-salut-accions">
        <button type="button" data-action="forjaObrirManifestar">
          <i class="fas fa-hand-sparkles"></i> {{localize "FORJA.Sobrenatural.BotoManifestar"}}
        </button>
      </div>

      {{#if disputaControl}}
      <div class="forja-disputa-control">
        <div class="dc-cap">
          <i class="fas fa-hand-fist"></i>
          {{localize "FORJA.Sobrenatural.DisputaTitol" nom=disputaControl.oponentNom efecte=disputaControl.efecteNom}}
        </div>
        <p class="dc-fites">
          {{localize "FORJA.Sobrenatural.DisputaFites" propies=disputaControl.fitesPropies oponent=disputaControl.fitesOponent marge=disputaControl.dificultatBase}}
        </p>
        {{#if disputaControl.esElSeuTorn}}
        <div class="dc-botons">
          <button type="button" data-action="forjaContinuarDisputa">
            <i class="fas fa-dice-d20"></i> {{localize "FORJA.Sobrenatural.DisputaContinuar"}}
          </button>
          <button type="button" class="dc-renunciar" data-action="forjaRenunciarDisputa">
            <i class="fas fa-flag"></i> {{localize "FORJA.Sobrenatural.DisputaRenunciar"}}
          </button>
        </div>
        {{else}}
        <p class="dc-espera">{{localize "FORJA.Sobrenatural.DisputaEspera"}}</p>
        {{/if}}
      </div>
      {{/if}}

      <div class="forja-efectes-cap">
        <span class="eq-nom">{{localize "FORJA.Section.Efectes"}}</span>
        {{#if modeEdicio}}
        <button type="button" class="btn-cap-afegir" data-action="crearEfecte" title="{{localize 'FORJA.Equip.AfegirEfecte'}}">
          <i class="fas fa-plus"></i>
        </button>
        <button type="button" class="btn-cap-afegir" data-action="forjaObrirConstructor" title="{{localize 'FORJA.Construccio.Boto'}}">
          <i class="fas fa-flask"></i>
        </button>
        {{/if}}
      </div>
      {{#if efectes.length}}
      <div class="forja-equip-llista">
        {{#each efectes as |e|}}
        <div class="forja-equip-fila" data-action="editarItem" data-item-id="{{e.id}}" title="{{e.descripcio}}">
          <span class="equip-nom">{{e.nom}}</span>
          <span class="equip-meta">{{e.cost}} PC · {{localize (concat "FORJA.Sobrenatural.Tipus." e.tipus)}} · dif. {{e.dificultat}}</span>
          {{#if ../modeEdicio}}
          <button type="button" class="btn-tret-eliminar" data-action="eliminarEfecte" data-item-id="{{e.id}}" title="{{localize 'FORJA.Equip.Eliminar'}}">
            <i class="fas fa-trash"></i>
          </button>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="trets-buits">{{localize "FORJA.Equip.SenseEfectes"}}</p>
      {{/if}}
    </div>
  </div>
  {{/if}}

  <!-- ═══ HABILITATS ═══ -->
  <div class="forja-seccio" data-seccio="habilitats">
    <div class="forja-seccio-cap" data-action="toggleSection">
      <i class="fas fa-chevron-down forja-chevron"></i>
      {{localize "FORJA.Tab.Habilitats"}}
    </div>
    <div class="forja-seccio-cos">
      <div class="forja-habs-cos">

        <!-- Columna esquerra -->
        <div class="forja-habs-columna">
          <div class="forja-habs-cap-fila">
            <span></span>
            <span class="hcap-nom">{{localize "FORJA.Hab.Nom"}}</span>
            <span class="hcap-esp">Esp.</span>
            <span class="hcap-niv">{{localize "FORJA.Hab.Nivell"}}</span>
          </div>
          {{#each habilitats.esquerra as |h|}}
          {{#if ../modeEdicio}}
          <div class="forja-hab-fila mode-edicio {{#if (eq h.tipus 'restringida')}}hab-restringida{{/if}}">
            <button type="button" class="hab-marca marca-{{h.marca}}"
                    data-action="toggleMarca" data-hab-id="{{h.id}}">{{h.marca}}</button>
            <span class="hab-nom">{{h.nom}}</span>
            <input type="text" class="hab-esp"
                   name="system.habilitats.{{h.id}}.especialitat"
                   value="{{h.especialitat}}" placeholder="esp."/>
            <div class="hab-stepper">
              <button type="button" class="btn-stepper-sm" data-action="ajustarHabilitat"
                      data-hab-id="{{h.id}}" data-delta="-1">−</button>
              <span class="hab-niv-val">{{h.nivell}}</span>
              <button type="button" class="btn-stepper-sm" data-action="ajustarHabilitat"
                      data-hab-id="{{h.id}}" data-delta="1">+</button>
            </div>
          </div>
          {{else}}
          <div class="forja-hab-fila {{#if (eq h.tipus 'restringida')}}hab-restringida{{/if}}"
               data-action="selectHabilitat" data-hab-id="{{h.id}}"
               title="{{h.nom}} — {{localize 'FORJA.Dice.TirarHabilitat'}}">
            <button type="button" class="hab-marca marca-{{h.marca}}"
                    data-action="toggleMarca" data-hab-id="{{h.id}}">{{h.marca}}</button>
            <span class="hab-nom">{{h.nom}}</span>
            <span class="hab-esp">{{#if h.especialitat}}{{h.especialitat}}{{/if}}</span>
            <span class="hab-niv-val">{{h.nivell}}</span>
          </div>
          {{/if}}
          {{/each}}
        </div>

        <!-- Columna dreta -->
        <div class="forja-habs-columna">
          <div class="forja-habs-cap-fila">
            <span></span>
            <span class="hcap-nom">{{localize "FORJA.Hab.Nom"}}</span>
            <span class="hcap-esp">Esp.</span>
            <span class="hcap-niv">{{localize "FORJA.Hab.Nivell"}}</span>
          </div>
          {{#each habilitats.dreta as |h|}}
          {{#if ../modeEdicio}}
          <div class="forja-hab-fila mode-edicio {{#if (eq h.tipus 'restringida')}}hab-restringida{{/if}}">
            <button type="button" class="hab-marca marca-{{h.marca}}"
                    data-action="toggleMarca" data-hab-id="{{h.id}}">{{h.marca}}</button>
            <span class="hab-nom">{{h.nom}}</span>
            <input type="text" class="hab-esp"
                   name="system.habilitats.{{h.id}}.especialitat"
                   value="{{h.especialitat}}" placeholder="esp."/>
            <div class="hab-stepper">
              <button type="button" class="btn-stepper-sm" data-action="ajustarHabilitat"
                      data-hab-id="{{h.id}}" data-delta="-1">−</button>
              <span class="hab-niv-val">{{h.nivell}}</span>
              <button type="button" class="btn-stepper-sm" data-action="ajustarHabilitat"
                      data-hab-id="{{h.id}}" data-delta="1">+</button>
            </div>
          </div>
          {{else}}
          <div class="forja-hab-fila {{#if (eq h.tipus 'restringida')}}hab-restringida{{/if}}"
               data-action="selectHabilitat" data-hab-id="{{h.id}}"
               title="{{h.nom}} — {{localize 'FORJA.Dice.TirarHabilitat'}}">
            <button type="button" class="hab-marca marca-{{h.marca}}"
                    data-action="toggleMarca" data-hab-id="{{h.id}}">{{h.marca}}</button>
            <span class="hab-nom">{{h.nom}}</span>
            <span class="hab-esp">{{#if h.especialitat}}{{h.especialitat}}{{/if}}</span>
            <span class="hab-niv-val">{{h.nivell}}</span>
          </div>
          {{/if}}
          {{/each}}
        </div>

      </div>
    </div>
  </div>

  <!-- ═══ TRETS ═══ -->
  <div class="forja-seccio" data-seccio="trets">
    <div class="forja-seccio-cap" data-action="toggleSection">
      <i class="fas fa-chevron-down forja-chevron"></i>
      {{localize "FORJA.Section.Trets"}}
      {{#if modeEdicio}}
      <button type="button" class="btn-cap-afegir" data-action="crearTret"
              title="{{localize 'FORJA.Tret.Nou'}}">
        <i class="fas fa-plus"></i>
      </button>
      {{/if}}
    </div>
    <div class="forja-seccio-cos">
      {{#if trets.length}}
      <div class="forja-trets-llista">
        {{#each trets as |t|}}
        <div class="forja-tret-fila">
          <span class="tret-nom">{{t.nom}}</span>
          <span class="tret-cost">{{t.cost}} PC</span>
          {{#if ../modeEdicio}}
          <button type="button" class="btn-tret-editar" data-action="editarTret"
                  data-tret-id="{{t.id}}" title="Editar">
            <i class="fas fa-pen"></i>
          </button>
          <button type="button" class="btn-tret-eliminar" data-action="eliminarTret"
                  data-tret-id="{{t.id}}" title="{{localize 'FORJA.Tret.Eliminar'}}">
            <i class="fas fa-trash"></i>
          </button>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="trets-buits">—</p>
      {{/if}}
    </div>
  </div>

  <!-- ═══ ARMES ═══ -->
  <div class="forja-seccio" data-seccio="armes">
    <div class="forja-seccio-cap" data-action="toggleSection">
      <i class="fas fa-chevron-down forja-chevron"></i>
      {{localize "FORJA.Section.Armes"}}
      {{#if modeEdicio}}
      <button type="button" class="btn-cap-afegir" data-action="crearArma"
              title="{{localize 'FORJA.Equip.AfegirArma'}}">
        <i class="fas fa-plus"></i>
      </button>
      {{/if}}
    </div>
    <div class="forja-seccio-cos">
      {{#if armes.length}}
      <div class="forja-equip-llista">
        {{#each armes as |a|}}
        <div class="forja-equip-fila" data-action="{{#if ../modeEdicio}}editarItem{{else}}selectArma{{/if}}" data-item-id="{{a.id}}" title="{{a.descripcio}}">
          <span class="equip-nom">{{a.nom}}</span>
          <span class="equip-meta">{{localize "FORJA.Display.LatenciaTotal"}} {{a.latenciaTotal}} (base {{a.modLatencia}}) · Tirada {{a.tirada.atribut}} {{a.tirada.atributVal}} + {{a.tirada.habId}} {{a.tirada.habNivell}} = {{a.tirada.pool}} {{localize "FORJA.Display.DausModificador"}} · {{localize "FORJA.Display.Dany"}} {{a.danyBase}} ({{a.danyValor}})</span>
          {{#if ../modeEdicio}}
          <button type="button" class="btn-tret-eliminar" data-action="eliminarArma"
                  data-item-id="{{a.id}}" title="{{localize 'FORJA.Equip.Eliminar'}}">
            <i class="fas fa-trash"></i>
          </button>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="trets-buits">{{localize "FORJA.Equip.SenseArmes"}}</p>
      {{/if}}
    </div>
  </div>

  <!-- ═══ ARMADURES ═══ -->
  <div class="forja-seccio" data-seccio="armadures">
    <div class="forja-seccio-cap" data-action="toggleSection">
      <i class="fas fa-chevron-down forja-chevron"></i>
      {{localize "FORJA.Section.Armadures"}}
      {{#if modeEdicio}}
      <button type="button" class="btn-cap-afegir" data-action="crearArmadura"
              title="{{localize 'FORJA.Equip.AfegirArmadura'}}">
        <i class="fas fa-plus"></i>
      </button>
      {{/if}}
    </div>
    <div class="forja-seccio-cos">
      {{#if armadures.length}}
      <div class="forja-equip-llista">
        {{#each armadures as |a|}}
        <div class="forja-equip-fila {{#unless a.equipada}}equip-inactiu{{/unless}}" data-action="editarItem" data-item-id="{{a.id}}" title="{{a.descripcio}}">
          <span class="equip-nom">{{a.nom}}</span>
          <span class="equip-meta">Lat. {{a.modLatencia}} · Reducció {{a.reduccio}} · {{localize (concat "FORJA.Armadura.Tipus." a.tipus)}}{{#unless a.equipada}} · {{localize "FORJA.Equip.NoEquipada"}}{{/unless}}</span>
          <button type="button" class="btn-equip-toggle {{#if a.equipada}}actiu{{/if}}" data-action="toggleEquipada"
                  data-item-id="{{a.id}}"
                  title="{{#if a.equipada}}{{localize 'FORJA.Equip.DesequiparTooltip'}}{{else}}{{localize 'FORJA.Equip.EquiparTooltip'}}{{/if}}">
            <i class="fas {{#if a.equipada}}fa-shield-halved{{else}}fa-shield{{/if}}"></i>
          </button>
          {{#if ../modeEdicio}}
          <button type="button" class="btn-tret-eliminar" data-action="eliminarArmadura"
                  data-item-id="{{a.id}}" title="{{localize 'FORJA.Equip.Eliminar'}}">
            <i class="fas fa-trash"></i>
          </button>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="trets-buits">{{localize "FORJA.Equip.SenseArmadures"}}</p>
      {{/if}}
    </div>
  </div>

  <!-- ═══ ARTEFACTES (S-24) ═══ -->
  <div class="forja-seccio" data-seccio="artefactes">
    <div class="forja-seccio-cap" data-action="toggleSection">
      <i class="fas fa-chevron-down forja-chevron"></i>
      {{localize "FORJA.Section.Artefactes"}}
      {{#if modeEdicio}}
      <button type="button" class="btn-cap-afegir" data-action="crearArtefacte"
              title="{{localize 'FORJA.Equip.AfegirArtefacte'}}">
        <i class="fas fa-plus"></i>
      </button>
      <button type="button" class="btn-cap-afegir" data-action="forjaObrirDissenyArtefacte"
              title="{{localize 'FORJA.Construccio.CrearArtefacte'}}">
        <i class="fas fa-microchip"></i>
      </button>
      {{/if}}
    </div>
    <div class="forja-seccio-cos">
      {{#if artefactes.length}}
      <div class="forja-equip-llista">
        {{#each artefactes as |a|}}
        <div class="forja-equip-fila" data-action="editarItem" data-item-id="{{a.id}}" title="{{a.mecanica}}">
          <span class="equip-nom">
            {{a.nom}}
            {{#if a.esPrototip}}<span class="forja-badge-prototip" title="{{localize (concat 'FORJA.Artefacte.Fase.' a.fase)}}">{{localize (concat "FORJA.Artefacte.Fase." a.fase)}}</span>{{/if}}
            {{#if a.trencat}}<span class="forja-badge-trencat" title="{{localize 'FORJA.Artefacte.Trencat'}}"><i class="fas fa-triangle-exclamation"></i></span>{{/if}}
          </span>
          <span class="equip-meta">
            {{#if a.modular}}{{a.totalModular.cost}} PC ({{localize "FORJA.Artefacte.Modular"}}){{else}}{{a.cost}} PC{{/if}} · {{localize (concat "FORJA.Artefacte.Categoria." a.categoria)}}
            {{#if a.activacio.dificultat}} · {{localize (concat "FORJA.Artefacte.Activacio." a.activacio.tipus)}} ({{localize "FORJA.Display.Dificultats"}} {{a.activacio.dificultat}}){{/if}}
            {{#if a.us.modLatencia}} · {{localize "FORJA.Display.Latencia"}} +{{a.us.modLatencia}}{{/if}}
            {{#if a.teCarrega}} · {{localize "FORJA.Artefacte.Carrega"}} {{a.carregaActual}}/{{a.carrega.usosPerCarrega}}{{/if}}
          </span>
          {{#if a.modular}}
          <div class="forja-moduls-llista">
            {{#each a.moduls as |m|}}
            <div class="forja-modul-fila">
              <span>{{m.nom}} ({{m.cost}} PC{{#if m.dificultat}}, {{m.dificultat}} dif.{{/if}})</span>
              {{#if ../../modeEdicio}}
              <button type="button" class="btn-tret-eliminar" data-action="forjaTreureModul" data-item-id="{{a.id}}" data-idx="{{m.idx}}" title="{{localize 'FORJA.Equip.Eliminar'}}">
                <i class="fas fa-trash"></i>
              </button>
              {{/if}}
            </div>
            {{/each}}
            {{#if ../modeEdicio}}
            <button type="button" class="btn-cap-afegir forja-modul-afegir" data-action="forjaAfegirModul" data-item-id="{{a.id}}" title="{{localize 'FORJA.Artefacte.AfegirModul'}}">
              <i class="fas fa-plus"></i> {{localize "FORJA.Artefacte.AfegirModul"}}
            </button>
            {{/if}}
          </div>
          {{/if}}
          <div class="forja-artefacte-accions">
            {{#if a.teCarrega}}
            <button type="button" class="btn-artefacte-carrega" data-action="forjaActivarArtefacte"
                    data-item-id="{{a.id}}" title="{{localize 'FORJA.Artefacte.Activar'}}">
              <i class="fas fa-bolt"></i>
            </button>
            <button type="button" class="btn-artefacte-carrega" data-action="forjaRecarregarArtefacte"
                    data-item-id="{{a.id}}" title="{{localize 'FORJA.Artefacte.Recarregar'}}">
              <i class="fas fa-battery-full"></i>
            </button>
            {{/if}}
            {{#if a.esPrototip}}
            <button type="button" class="btn-artefacte-carrega" data-action="forjaProvarPrototip"
                    data-item-id="{{a.id}}" title="{{localize 'FORJA.Artefacte.ProvarPrototip'}}">
              <i class="fas fa-screwdriver-wrench"></i>
            </button>
            {{#if ../modeEdicio}}
            {{#if a.trencat}}
            <button type="button" class="btn-artefacte-carrega" data-action="forjaRepararPrototip"
                    data-item-id="{{a.id}}" title="{{localize 'FORJA.Artefacte.RepararPrototip'}}">
              <i class="fas fa-check"></i>
            </button>
            {{/if}}
            <button type="button" class="btn-artefacte-carrega" data-action="forjaMarcarProduccio"
                    data-item-id="{{a.id}}" title="{{localize 'FORJA.Artefacte.MarcarProduccio'}}">
              <i class="fas fa-flag-checkered"></i>
            </button>
            {{/if}}
            {{/if}}
            {{#if ../modeEdicio}}
            <button type="button" class="btn-artefacte-carrega {{#if a.modular}}forja-modular-actiu{{/if}}" data-action="forjaToggleModular"
                    data-item-id="{{a.id}}" title="{{localize 'FORJA.Artefacte.FerModular'}}">
              <i class="fas fa-puzzle-piece"></i>
            </button>
            <button type="button" class="btn-tret-eliminar" data-action="eliminarArtefacte"
                    data-item-id="{{a.id}}" title="{{localize 'FORJA.Equip.Eliminar'}}">
              <i class="fas fa-trash"></i>
            </button>
            {{/if}}
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="trets-buits">{{localize "FORJA.Equip.SenseArtefactes"}}</p>
      {{/if}}
    </div>
  </div>

  <!-- ═══ NOTES ═══ -->
  <div class="forja-seccio" data-seccio="notes">
    <div class="forja-seccio-cap" data-action="toggleSection">
      <i class="fas fa-chevron-down forja-chevron"></i>
      {{localize "FORJA.Section.Notes"}}
    </div>
    <div class="forja-seccio-cos">
      {{editor sys.notes target="system.notes" button=true engine="prosemirror" collaborate=false}}
    </div>
  </div>

</div>
