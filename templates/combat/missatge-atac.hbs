<div class="forja-missatge-atac {{#if pifia}}missatge-pifia{{else}}{{#if exit}}missatge-exit{{else}}missatge-fallada{{/if}}{{/if}}">

  <!-- Capçalera -->
  <div class="mt-cap">
    <span class="mt-label">{{nomAtacant}} ataca {{nomObjectiu}} amb {{nomArma}}{{#if etiquetaRang}} ({{etiquetaRang}}){{/if}}</span>
    <span class="mt-dif">{{localize "FORJA.Display.Defensa"}} {{dificultat}}{{#if etiquetaDefensa}} ({{etiquetaDefensa}}){{/if}}</span>
  </div>

  {{#if maniobra}}
  <div class="mt-maniobra" title="{{maniobra.descripcio}}">
    <i class="fas fa-hand-fist"></i> {{maniobra.nom}} <span class="mt-mod">(+{{maniobra.dificultat}} {{localize "FORJA.Display.Dificultats"}})</span>
  </div>
  {{/if}}

  {{#if (or penalSalut concentrat)}}
  <div class="mt-mods">
    {{#if concentrat}}<span class="mt-mod">{{localize "FORJA.Dice.ConcentratBonus"}}</span>{{/if}}
    {{#if penalSalut}}<span class="mt-mod mt-mod-penal">{{localize "FORJA.Dice.PenalSalutMod" valor=penalSalut}}</span>{{/if}}
  </div>
  {{/if}}

  {{#if bonusRetard}}
  <div class="mt-mods">
    <span class="mt-mod">{{localize "FORJA.Combat.RetardBarallarseBonus" valor=bonusRetard}}</span>
  </div>
  {{/if}}

  <!-- Daus -->
  <div class="mt-daus">
    {{#each dice as |d|}}
    <span class="mt-dau {{dieClass d}}">{{d}}</span>
    {{/each}}
  </div>

  <!-- Resultat de l'atac -->
  <div class="mt-resultat">
    {{#if pifia}}
      <span class="mt-badge badge-pifia"><i class="fas fa-skull"></i> {{localize "FORJA.Display.Pifia"}}</span>
    {{else if exit}}
      <span class="mt-badge badge-exit">
        <i class="fas fa-bullseye"></i> {{localize "FORJA.Combat.Impacta"}}
        {{#if excedent}}<span class="mt-excedent">+{{excedent}} {{localize "FORJA.Display.Excedent"}}</span>{{/if}}
      </span>
    {{else}}
      <span class="mt-badge badge-fallada">
        <i class="fas fa-xmark"></i> {{localize "FORJA.Combat.Falla"}}
      </span>
    {{/if}}
  </div>

  <!-- Resultat del dany -->
  {{#if dany}}
  <div class="mt-dany">
    {{#if dany.danyFinal}}
      <span class="mt-badge badge-dany">
        <i class="fas fa-droplet"></i> {{dany.danyFinal}} {{pistaEtiqueta}}
      </span>
    {{else}}
      <span class="mt-badge badge-sense-dany">
        <i class="fas fa-shield"></i> {{localize "FORJA.Combat.SenseDany"}}
      </span>
    {{/if}}
    {{#if dany.egidaTrencada}}
      <span class="mt-mod mt-mod-penal">
        {{localize "FORJA.Combat.EgidaTrencada"}} ({{dany.tornsInactivaEgida}} {{localize "FORJA.Combat.Torns"}})
      </span>
    {{/if}}
  </div>
  {{/if}}

  {{#if notes.length}}
  <ul class="mt-notes">
    {{#each notes as |n|}}<li>{{n}}</li>{{/each}}
  </ul>
  {{/if}}

</div>
