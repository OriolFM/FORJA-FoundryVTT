<div class="forja-missatge-atac forja-missatge-curacio {{#if pifia}}missatge-pifia{{else}}{{#if exit}}missatge-exit{{else}}missatge-fallada{{/if}}{{/if}}">

  <div class="mt-cap">
    <span class="mt-label">
      {{nomGuaridor}}
      {{#if (eq tipus "tractament-medic")}}{{localize "FORJA.Curacio.TractamentMedic"}}{{else}}{{localize "FORJA.Curacio.PrimersAuxilis"}}{{/if}}
      a {{nomObjectiu}} ({{habNom}})
    </span>
    <span class="mt-dif">dif. {{dificultat}}</span>
  </div>

  <div class="mt-daus">
    {{#each dice as |d|}}
    <span class="mt-dau {{dieClass d}}">{{d}}</span>
    {{/each}}
  </div>

  <div class="mt-resultat">
    {{#if pifia}}
      <span class="mt-badge badge-pifia"><i class="fas fa-skull"></i> PÍFIA</span>
    {{else if exit}}
      <span class="mt-badge badge-exit">
        <i class="fas fa-kit-medical"></i> {{localize "FORJA.Combat.Impacta"}}
        {{#if excedent}}<span class="mt-excedent">+{{excedent}} exc.</span>{{/if}}
      </span>
    {{else}}
      <span class="mt-badge badge-fallada">
        <i class="fas fa-xmark"></i> {{localize "FORJA.Combat.Falla"}}
      </span>
    {{/if}}
  </div>

  {{#if excedent}}
  <div class="mt-dany">
    <span class="mt-badge badge-dany">
      <i class="fas fa-heart"></i> {{excedent}} {{localize (concat "FORJA.Salut." pista)}} {{localize "FORJA.Curacio.Guarits"}}
    </span>
  </div>
  {{/if}}

</div>
