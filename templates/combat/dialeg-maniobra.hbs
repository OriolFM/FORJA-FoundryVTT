<div class="forja-dialeg-maniobra">
  <p class="dm-intro">{{localize "FORJA.Combat.ManiobraIntro" nom=nom}}</p>

  <div class="form-group dm-opcions">
    <label class="dm-radio">
      <input type="radio" name="maniobraId" value="cap" {{#if (eq maniobraId "cap")}}checked{{/if}}>
      {{localize "FORJA.Combat.SenseManiobra"}}
    </label>
    {{#each maniobres as |m|}}
    <label class="dm-radio">
      <input type="radio" name="maniobraId" value="{{m.id}}" {{#if (eq m.id ../maniobraId)}}checked{{/if}}>
      {{m.nom}} <span class="dm-dif">(+{{m.dificultat}} dif.)</span>
    </label>
    {{/each}}
  </div>

  {{#each maniobres as |m|}}
  {{#if (eq m.id ../maniobraId)}}
  <p class="dm-desc">{{m.descripcio}}</p>
  {{/if}}
  {{/each}}

  <button type="submit">
    <i class="fas fa-fist-raised"></i> {{localize "FORJA.Combat.ManiobraConfirmar"}}
  </button>
</div>
