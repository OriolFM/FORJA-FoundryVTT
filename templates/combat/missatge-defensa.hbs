<div class="forja-missatge-tirada forja-missatge-defensa {{#if pifia}}missatge-pifia{{else}}missatge-exit{{/if}}">

  <div class="mt-cap">
    <span class="mt-label">
      {{#if nomAtacant}}{{localize "FORJA.Combat.DefensaXatContra" defensor=nomDefensor opcio=nomOpcio atacant=nomAtacant}}{{else}}{{localize "FORJA.Combat.DefensaXat" defensor=nomDefensor opcio=nomOpcio}}{{/if}}
    </span>
    <span class="mt-dif">{{atribut}}{{#if habId}} + {{habId}}{{/if}}</span>
  </div>

  <div class="mt-daus">
    {{#each dice as |d|}}
    <span class="mt-dau {{dieClass d}}">{{d}}</span>
    {{/each}}
  </div>

  <div class="mt-resultat">
    {{#if pifia}}<span class="mt-badge badge-pifia"><i class="fas fa-skull"></i> PÍFIA</span>{{/if}}
    <span class="mt-badge badge-exit">
      <i class="fas fa-shield-halved"></i>
      {{localize "FORJA.Combat.DefensaResultant" valor=dificultat}}
    </span>
  </div>

  <div class="mt-mods">
    <span class="mt-mod">{{fites}} {{localize "FORJA.Dice.Fites"}}</span>
    {{#if penalSalut}}<span class="mt-mod mt-mod-penal">{{localize "FORJA.Combat.PenalSalutFites" valor=penalSalut}}</span>{{/if}}
    {{#if minimAplicat}}<span class="mt-mod">{{localize "FORJA.Combat.DefensaMinimAplicat" valor=dificultatMinima}}</span>{{/if}}
    {{#if danyExtra}}<span class="mt-mod mt-mod-penal">{{localize "FORJA.Combat.PifiaEsquivarDany" valor=danyExtra}}</span>{{/if}}
  </div>

</div>
