<div class="forja-dialeg-declarar-accio">
  <p>
    {{localize "FORJA.Combat.MarcadorActual"}}: <strong>{{marcador}}</strong>
    — {{localize "FORJA.Combat.PosicioActual"}}: <strong>{{posicioActual}}</strong>
    — {{localize "FORJA.Combat.LatenciaBase"}}: <strong>{{latenciaBase}}</strong>
  </p>

  {{#if estatsActius}}
  <p class="dda-avis dda-estats"><i class="fas fa-triangle-exclamation"></i> {{localize "FORJA.Estats.Actius"}}: <strong>{{estatsActius}}</strong></p>
  {{/if}}

  <div class="form-group dda-tipus">
    <label>{{localize "FORJA.Combat.TipusAccio"}}</label>
    <label class="dda-radio">
      <input type="radio" name="tipus" value="atac" {{#if (eq tipus "atac")}}checked{{/if}} {{#if bloqueigTipus.atac}}disabled title="{{bloqueigTipus.atac}}"{{/if}} {{#unless armes.length}}disabled{{/unless}}>
      {{localize "FORJA.Combat.Accio.Atac"}}
    </label>
    <label class="dda-radio">
      <input type="radio" name="tipus" value="defensa" {{#if (eq tipus "defensa")}}checked{{/if}} {{#if bloqueigTipus.defensa}}disabled title="{{bloqueigTipus.defensa}}"{{/if}}>
      {{localize "FORJA.Combat.Accio.Defensa"}}
    </label>
    <label class="dda-radio">
      <input type="radio" name="tipus" value="moviment" {{#if (eq tipus "moviment")}}checked{{/if}} {{#if bloqueigTipus.moviment}}disabled title="{{bloqueigTipus.moviment}}"{{/if}}>
      {{localize "FORJA.Combat.Accio.Moviment"}}
    </label>
    {{#if efectes.length}}
    <label class="dda-radio">
      <input type="radio" name="tipus" value="manifestar" {{#if (eq tipus "manifestar")}}checked{{/if}} {{#if bloqueigTipus.manifestar}}disabled title="{{bloqueigTipus.manifestar}}"{{/if}}>
      {{localize "FORJA.Combat.Accio.Manifestar"}}
    </label>
    {{/if}}
    {{#if artefactes.length}}
    <label class="dda-radio">
      <input type="radio" name="tipus" value="artefacte" {{#if (eq tipus "artefacte")}}checked{{/if}} {{#if bloqueigTipus.artefacte}}disabled title="{{bloqueigTipus.artefacte}}"{{/if}}>
      {{localize "FORJA.Combat.Accio.Artefacte"}}
    </label>
    {{/if}}
    <label class="dda-radio">
      <input type="radio" name="tipus" value="altra" {{#if (eq tipus "altra")}}checked{{/if}} {{#if bloqueigTipus.altra}}disabled title="{{bloqueigTipus.altra}}"{{/if}}>
      {{localize "FORJA.Combat.Accio.Altra"}}
    </label>
  </div>

  {{#if (eq tipus "moviment")}}
  <p class="dda-avis">{{localize "FORJA.Combat.AvisMoviment"}}</p>
  {{/if}}

  {{#if (eq tipus "manifestar")}}
  <div class="form-group">
    <label>{{localize "FORJA.Combat.Efecte"}}</label>
    <select name="efecteId">
      {{#each efectes as |e|}}<option value="{{e.id}}" {{#if (eq e.id ../efecteId)}}selected{{/if}}>{{e.nom}} (dif. {{e.dificultat}}, lat. {{e.modLatencia}})</option>{{/each}}
    </select>
  </div>
  {{/if}}
  {{#if (eq tipus "artefacte")}}
  <div class="form-group">
    <label>{{localize "FORJA.Combat.ArtefacteDeclarat"}}</label>
    <select name="artefacteId">
      {{#each artefactes as |a|}}<option value="{{a.id}}" {{#if (eq a.id ../artefacteId)}}selected{{/if}}>{{a.nom}} (lat. {{a.modLatencia}})</option>{{/each}}
    </select>
  </div>
  {{/if}}
  {{#if (or (eq tipus "manifestar") (eq tipus "artefacte"))}}
  <div class="form-group">
    <label>{{localize "FORJA.Combat.Objectiu"}}</label>
    <select name="objectiuTokenId">
      <option value="" {{#unless objectiuTokenId}}selected{{/unless}}>{{localize "FORJA.Combat.SenseObjectiuDeclarat"}}</option>
      {{#each objectius as |o|}}
      <option value="{{o.tokenId}}" {{#if (eq o.tokenId ../objectiuTokenId)}}selected{{/if}}>{{o.etiqueta}}</option>
      {{/each}}
    </select>
  </div>
  {{/if}}

  {{#if (eq tipus "atac")}}
  <div class="form-group">
    <label>{{localize "FORJA.Combat.Arma"}}</label>
    {{#if armes.length}}
    <select name="armaId">
      {{#each armes as |a|}}
      <option value="{{a.id}}" {{#if (eq a.id ../armaId)}}selected{{/if}}>{{a.nom}} ({{a.latenciaTotal}})</option>
      {{/each}}
    </select>
    {{else}}
    <p class="dda-avis">{{localize "FORJA.Combat.SenseArmes"}}</p>
    {{/if}}
  </div>
  <div class="form-group">
    <label>{{localize "FORJA.Combat.Objectiu"}}</label>
    <select name="objectiuTokenId">
      <option value="" {{#unless objectiuTokenId}}selected{{/unless}}>{{localize "FORJA.Combat.SenseObjectiuDeclarat"}}</option>
      {{#each objectius as |o|}}
      <option value="{{o.tokenId}}" {{#if (eq o.tokenId ../objectiuTokenId)}}selected{{/if}}>
        {{o.etiqueta}}
      </option>
      {{/each}}
    </select>
  </div>
  {{#if avisObjectiu}}
  <p class="dda-avis">{{avisObjectiu}}</p>
  {{/if}}
  {{#if modesTret.length}}
  <div class="form-group">
    <label>{{localize "FORJA.Combat.ModeTretEtiqueta"}}</label>
    <select name="modeTret">
      {{#each modesTret as |m|}}<option value="{{m.id}}" {{#if (eq m.id ../modeTret)}}selected{{/if}}>{{m.nom}}</option>{{/each}}
    </select>
  </div>
  {{/if}}
  {{#if (or armaArea (eq modeTret "automatic"))}}
  <p class="dda-avis">{{localize "FORJA.Combat.AvisArea"}}</p>
  {{/if}}
  {{#if permetManiobres}}
  <div class="form-group">
    <label>{{localize "FORJA.Combat.Maniobra"}}</label>
    <select name="maniobraId">
      <option value="" {{#unless maniobraId}}selected{{/unless}}>{{localize "FORJA.Combat.SenseManiobra"}}</option>
      {{#each maniobres as |m|}}
      <option value="{{m.id}}" {{#if (eq m.id ../maniobraId)}}selected{{/if}}>{{m.nom}} (+{{m.dificultat}} dif.)</option>
      {{/each}}
    </select>
  </div>
  {{#if maniobra}}
  <p class="dda-avis">{{maniobra.descripcio}}<br>{{localize "FORJA.Combat.ManiobraTirada"}}</p>
  {{/if}}
  {{#if esDimMak}}
  <div class="form-group">
    <label>{{localize "FORJA.Combat.DimMakEtiqueta"}}</label>
    <select name="dimMak">
      <option value="ferides" {{#if (eq dimMak "ferides")}}selected{{/if}}>{{localize "FORJA.Combat.DimMak.ferides"}}</option>
      <option value="fatiga" {{#if (eq dimMak "fatiga")}}selected{{/if}}>{{localize "FORJA.Combat.DimMak.fatiga"}}</option>
    </select>
  </div>
  {{/if}}
  {{/if}}
  {{#if retardMax}}
  <div class="form-group">
    <label>{{localize "FORJA.Combat.RetardBarallarse"}}</label>
    <input type="number" name="retardBarallarse" value="{{retard}}" min="0" max="{{retardMax}}" step="1">
  </div>
  <p class="hint">{{localize "FORJA.Combat.RetardBarallarseDesc" max=retardMax}}</p>
  {{/if}}
  {{/if}}

  {{#if (eq tipus "defensa")}}
  <div class="form-group">
    <label>{{localize "FORJA.Combat.DefensaTipus"}}</label>
    <select name="defensaId">
      {{#each defenses as |dfn|}}
      <option value="{{dfn.id}}" {{#if (eq dfn.id ../defensaId)}}selected{{/if}}>
        {{dfn.nom}}
        {{#if dfn.senseTirada}} — {{localize "FORJA.Combat.SenseTirada"}}{{else}} — {{dfn.atribut}} {{dfn.atributVal}} + {{dfn.habId}} {{dfn.habNivell}} = {{localize "FORJA.Combat.DausPool" pool=dfn.pool}}{{/if}}
      </option>
      {{/each}}
    </select>
  </div>
  {{#each defenses as |dfn|}}
  {{#if (eq dfn.id ../defensaId)}}
  <p class="dda-avis">
    {{dfn.descripcio}}
    {{#if dfn.senseTirada}}
      {{#if dfn.reduccioExtra}}<br>{{localize "FORJA.Combat.ReduccioExtra" valor=dfn.reduccioExtra}}{{/if}}
    {{/if}}
  </p>
  {{/if}}
  {{/each}}
  {{/if}}

  {{#if (eq tipus "altra")}}
  <div class="form-group">
    <label>{{localize "FORJA.Combat.Modificador"}}</label>
    <input type="number" name="modificador" value="0" step="1">
  </div>
  {{/if}}

  <div class="form-group dda-moviment">
    <label>{{localize "FORJA.Moviment.Tipus"}}</label>
    <select name="moviment">
      {{#each moviments as |m|}}
      <option value="{{m}}" {{#if (eq m ../moviment)}}selected{{/if}}>
        {{#if (eq m "basic")}}{{localize "FORJA.Moviment.Basic"}}{{/if}}
        {{#if (eq m "rapid")}}{{localize "FORJA.Moviment.Rapid"}}{{/if}}
        {{#if (eq m "especial")}}{{localize "FORJA.Moviment.Especial"}}{{/if}}
        {{#if (eq m "carrega")}}{{localize "FORJA.Moviment.Carrega"}}{{/if}}
      </option>
      {{/each}}
    </select>
  </div>
  {{#if noEsMou}}
  <p class="dda-avis">{{localize "FORJA.Estats.NoEsMou"}}</p>
  {{/if}}
  <p class="hint">
    {{#if (eq moviment "basic")}}{{localize "FORJA.Moviment.BasicDesc" metres=metresMoviment}}{{/if}}
    {{#if (eq moviment "rapid")}}{{localize "FORJA.Moviment.RapidDesc" metres=metresMoviment}}{{/if}}
    {{#if (eq moviment "especial")}}{{localize "FORJA.Moviment.EspecialDesc" metres=metresMoviment}}{{/if}}
    {{#if (eq moviment "carrega")}}{{localize "FORJA.Moviment.CarregaDesc" metres=metresMoviment}}{{/if}}
  </p>

  {{#if (eq tipus "defensa")}}
  <p class="hint">{{localize "FORJA.Combat.DefensaCompletaConcentrada"}}</p>
  {{else}}
  <div class="form-group dda-concentrar">
    <label title="{{localize 'FORJA.Combat.ConcentrarDesc'}}">
      <input type="checkbox" name="concentrar" {{#if concentrar}}checked{{/if}} {{#unless potConcentrar}}disabled{{/unless}}>
      {{localize "FORJA.Combat.Concentrar"}}
    </label>
    <p class="hint">{{localize "FORJA.Combat.ConcentrarDesc"}}</p>
  </div>
  {{/if}}

  <div class="form-group">
    <label>{{localize "FORJA.Combat.Latencia"}}</label>
    <input type="number" name="latencia" value="{{latencia}}" min="1" step="1">
  </div>

  <div class="form-group">
    <label>{{localize "FORJA.Combat.Descripcio"}}</label>
    <textarea name="descripcio" rows="2" placeholder="{{localize 'FORJA.Combat.DescripcioPlaceholder'}}">{{descripcio}}</textarea>
  </div>

  <button type="submit">
    <i class="fas fa-stopwatch"></i> {{localize "FORJA.Combat.Declarar"}}
  </button>
</div>
